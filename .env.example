# Create an OAuth app at https://github.com/settings/developers.
# Set its callback URL to the public URL where Gitstars will be served.
VITE_GITSTARS_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Host port exposed by Docker Compose.
GITSTARS_PORT=8080

# Directory containing localhost.pem and localhost-key.pem.
GITSTARS_CERT_DIR=./.certs
